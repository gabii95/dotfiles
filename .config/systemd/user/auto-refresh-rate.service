[Unit]
Description=Auto switch monitor refresh rate between 60Hz (battery) and 120Hz (AC)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/home/gabriel/.local/bin/auto-refresh-rate
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
