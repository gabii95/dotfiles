{
  "document": { "margin": 2 },
  "block_quote": { "indent": 1, "indent_token": "▎ ", "color": "245", "italic": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "228", "background_color": "63", "bold": true, "block_suffix": "\n" },
  "h2": { "prefix": "▌ ", "color": "39", "bold": true },
  "h3": { "prefix": "▍ ", "color": "42", "bold": true },
  "h4": { "prefix": "", "color": "214", "bold": true },
  "h5": { "prefix": "", "color": "214", "bold": true },
  "h6": { "prefix": "", "color": "245", "bold": true },
  "strong": { "bold": true, "color": "213" },
  "emph": { "italic": true, "color": "180" },
  "hr": { "color": "240", "format": "────────────────────────" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "39", "underline": true },
  "link_text": { "color": "75", "bold": true },
  "code": { "prefix": " ", "suffix": " ", "color": "215", "background_color": "236" },
  "code_block": { "margin": 2, "color": "252" },
  "table": {
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  }
}
